# API keys used to live here as VITE_GEMINI_API_KEY / VITE_FAL_API_KEY, which
# Vite would inline directly into the shipped browser bundle -- anyone could
# open dev tools and read them out. All AI calls now go through Firebase
# Cloud Functions (see functions/src/index.ts), which hold the real secrets
# server-side. Set them there instead, once per environment:
#
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set FAL_API_KEY   # optional, powers both Seedance and Kling
#
# The client only needs the public Firebase project config, which already
# lives in firebase-applet-config.json. Firebase web config values (unlike
# the keys above) are meant to be public -- access is controlled by
# firestore.rules/storage.rules, not by hiding this file.

# Optional: error monitoring (see README's "Error monitoring" section).
# Leave blank to skip Sentry entirely -- it's never even downloaded without this.
# Also set as a Cloud Functions secret for server-side crash reporting:
#   firebase functions:secrets:set SENTRY_DSN
VITE_SENTRY_DSN=

# Optional: staging isolation (see README's "Staging environment" section).
# Set these ONLY on a Vercel Preview deployment's environment variables,
# pointed at a second, separate Firebase project -- leave all blank (as in
# Production) to use the committed firebase-applet-config.json instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
